[Unit]
Description=Bible reading Telegram bot
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=biblebot
Group=biblebot
WorkingDirectory=/opt/bible-bot
EnvironmentFile=/opt/bible-bot/.env
ExecStart=/opt/bible-bot/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
